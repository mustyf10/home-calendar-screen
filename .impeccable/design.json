  "narrative": {
    "northStar": "The Recipe Box",
    "overview": "A household tool that looks like the kitchen it serves: peach-white surfaces, white cards lifted by a soft shadow, one committed tangerine for the actions and states that matter, a deep walnut for the single strongest header action, and drawn line icons. Food photography carries the colour in the recipe grid, so the chrome stays calm. It was taken from the user's chosen Dribbble reference (a warm orange recipe app) and adapted to the app's real content. The same shapes recur on the e-ink panel in black and white: a black rounded date block, outlined pill section headers and black rounded \"today\" markers where the web UI uses tangerine ones. The panel keeps its DejaVu Sans, 1-bit, fixed 800×480 layout.",
    "keyCharacteristics": [
      "Light only (`data-theme=\"light\"`; Pico's dark tokens would break the palette), warm neutrals tinted toward orange, never grey.",
      "Tangerine is reserved for primary action, current day and the unread badge.",
      "14–18px radii, pill chips and nav states, soft offset shadows.",
      "Rail navigation with \"Plan\" and \"Manage\" groups on desktop; a top bar with a scrolling pill nav on phones."
    ],
    "rules": [
      {
        "name": "The One Orange Rule",
        "body": "Tangerine marks what the user can act on or what is today; it is not a decorative fill. Counts, decorative icons and selected-category text are cocoa, clay or walnut; only the icon of the selected nav item or category turns tangerine.",
        "section": "colors"
      },
      {
        "name": "The Weight Over Size Rule",
        "body": "Distinguish levels with weight and colour first; headings are balanced and tracked at -0.015em. No eyebrow labels above headings: a recipe's type sits below its title.",
        "section": "typography"
      },
      {
        "name": "The Warm Shadow Rule",
        "body": "Shadows are tinted with walnut or tangerine, never neutral black.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep the page ground peach-white and the cards white.",
      "**Do** use tangerine only for primary actions, the current day and badges; walnut for at most one header action per page.",
      "**Do** use the drawn icons from `_icons.html` at one stroke weight.",
      "**Do** keep the panel pure black and white with rounded \"today\" blocks; no greys."
    ],
    "donts": [
      "**Don't** add a dark theme; the app is light only.",
      "**Don't** use emoji or text glyphs as icons.",
      "**Don't** put coloured side stripes on cards or rows.",
      "**Don't** add a raw colour outside the token block in `app.css`.",
      "**Don't** change the panel geometry or font (800×480, DejaVu Sans) without re-checking the weather strip, warning and offline stamp."
    ]
  }
