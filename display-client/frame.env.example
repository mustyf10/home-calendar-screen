FRAME_URL=http://your-server:8000/display/frame.png
# Default adapter: Raspberry Pi + Waveshare 7.5" V2 (800x480).
# FRAME_DRIVER=adapters.waveshare7in5_v2:create
# Custom adapters are trusted, locally installed Python module:factory callables.
# FRAME_DRIVER=my_panel:create
# Optional dimensions; in real mode they must match the adapter's spec.
# FRAME_WIDTH=800
# FRAME_HEIGHT=480
# Hardware libraries, transport and physical pin setup belong to the selected adapter.
# Use a separate --state-dir for each physical screen; never share refresh history.
# Only for HTTPS with a private certificate authority: path to its root certificate.
CA_FILE=
# Night pause times and timezone come from the server's Settings → Display.
